# ===========================================
# 2026世界杯小程序 · 生产环境配置模板
# 复制此文件为 .env 并填写实际值
# ===========================================

# ----- 数据库 -----
# 生产环境推荐使用 PostgreSQL（Railway/Render/Supabase 免费额度均可）
# DATABASE_URL=postgresql://user:password@host:5432/worldcup2026
# 留空则自动使用 SQLite（适合展示/开发，不支持并发写入）

# ----- 微信小程序 -----
WECHAT_APPID=wx98f7c06dd3ca0a00
# ⚠️ 必填：从微信公众平台 → 开发 → 开发管理 → 开发设置 获取 AppSecret
WECHAT_SECRET=your_app_secret_here

# ----- API-Football（可选，实时比赛数据）-----
# 注册 https://www.api-football.com/ 获取免费 Key（100次/天）
# API_FOOTBALL_KEY=your_api_key_here

# ----- 服务器 -----
PORT=3456

# ----- 日志 -----
LOG_LEVEL=info
# 可选: trace | debug | info | warn | error | fatal
